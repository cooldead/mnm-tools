{
  "name": "mnm-minimap",
  "version": "0.3.12",
  "description": "Map and marker companion app for the MMO Monsters & Memories",
  "main": "main.js",
  "author": "Zak (threefires)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Boisteroux/mnm-tools.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --config.asar=false",
    "dist:linux": "electron-builder --linux AppImage --config.asar=false",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "jimp": "^0.22.12",
    "sharp": "^0.35.1"
  },
  "build": {
    "appId": "xyz.threefires.mnmmap",
    "productName": "MnM Map",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "tracker/**/*",
      "zone-aliases.json",
      "mnmdb/wiki.json",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "build/icon.png",
      "synopsis": "Map and marker companion for Monsters & Memories",
      "artifactName": "MnM-Map-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MnM-Map-Setup-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@32.3.3": true
  }
}
